# Production compatibility contract. Keep this file shell-compatible: packaging
# and verification source it directly, while CI is checked against the same
# values by scripts/verify-macos-support.sh.
WRENFLOW_MACOS_MIN=14.0
WRENFLOW_MACOS_CURRENT_MAJOR=26
WRENFLOW_MACOS_ARCH=arm64
WRENFLOW_RUST_TARGET=aarch64-apple-darwin
WRENFLOW_MINIMUM_APPLE_SILICON=Apple_M1
WRENFLOW_RUST_VERSION=1.94.1
WRENFLOW_ORT_VERSION=1.24.2
WRENFLOW_ORT_MINOS=14.0
WRENFLOW_MIN_RUNNER=macos-14
WRENFLOW_MIN_XCODE=16.2
WRENFLOW_CURRENT_RUNNER=macos-26
WRENFLOW_CURRENT_XCODE=26.3
