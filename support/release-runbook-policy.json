{
  "schema_version": 1,
  "release_line": "gpui-first-public-v1",
  "release_assumption": {
    "existing_users": 0,
    "production_deployments": 0,
    "compatibility_scope": "clean_first_install_only",
    "legacy_migration": "not_supported",
    "downgrade_or_rollback": "not_supported",
    "update_from_prerelease": "not_a_release_gate"
  },
  "preflight": {
    "required_tracker_gates": [
      "wrenflow-duh.9.8",
      "wrenflow-duh.9.9",
      "wrenflow-duh.9.10",
      "wrenflow-duh.9.11"
    ]
  },
  "owner": {
    "name": "Ilya Gulya",
    "contact": "ilya@gulya.me"
  },
  "privacy": {
    "default_telemetry": "disabled",
    "prohibited_evidence": [
      "audio",
      "transcript",
      "vocabulary",
      "device_identifier",
      "full_local_path",
      "credential"
    ],
    "owner_evidence_retention_days": 30
  },
  "go_no_go": {
    "decision_mode": "single_owner_recorded",
    "required_gates": [
      "exact_signed_notarized_private_stable_draft",
      "sealed_automated_performance_24_of_24",
      "owner_core_first_install_smoke",
      "owner_accessibility_appearance_display_smoke",
      "owner_first_release_lifecycle_smoke",
      "security_privacy_supply_chain"
    ],
    "open_release_blockers_max": 0,
    "security_privacy_or_data_loss_events_max": 0,
    "signature_notary_gatekeeper_failures_max": 0,
    "core_workflow_failures_max": 0,
    "support_bundle_secret_findings_max": 0
  },
  "promotion": {
    "policy": "exact_private_draft_bytes_only",
    "stable_architecture": "release_please_draft_then_manual_exact_byte_promotion",
    "private_draft_identity": "exact_positive_github_release_id",
    "staged_payload_retention_days": 21,
    "promotion_evidence_retention_days": 30,
    "required_tracker_gates": [
      "wrenflow-duh.9.8",
      "wrenflow-duh.9.9",
      "wrenflow-duh.9.10",
      "wrenflow-duh.9.11"
    ],
    "github_environment_required": false,
    "required_external_reviewers": 0
  },
  "post_publish": {
    "required_checks": [
      "release_is_public_and_not_prerelease",
      "latest_points_to_exact_tag",
      "nine_asset_allowlist",
      "public_dmg_sha256_matches_draft",
      "public_redownload_passes_signature_notary_gatekeeper"
    ],
    "production_watch_hours": 0,
    "cohort_required": false
  }
}
