#!/usr/bin/env bash
set -euo pipefail

FAILED=0

# Rust, Swift, manifests and the task graph can affect either Cargo workspace.
# The aggregate mise tasks cover both the root workspace and the isolated GPUI
# workspace through the repository's managed task graph.
STAGED_BUILD_INPUTS=$(
  git diff --cached --name-only --diff-filter=ACMRD |
    grep -E '(^|/)(Cargo\.toml|Cargo\.lock|build\.rs)$|\.(rs|swift)$|^mise\.toml$' || true
)
if [ -n "$STAGED_BUILD_INPUTS" ]; then
  echo "Running root and GPUI checks through mise..."
  if ! mise run check; then
    FAILED=1
  fi

  echo "Running root, GPUI and workflow linters through mise..."
  if ! mise run lint; then
    FAILED=1
  fi
fi

# Workflow-only commits do not need to compile both Cargo workspaces.
STAGED_WORKFLOWS=$(git diff --cached --name-only --diff-filter=ACMRD | grep '^\.github/workflows/' || true)
if [ -n "$STAGED_WORKFLOWS" ] && [ -z "$STAGED_BUILD_INPUTS" ]; then
  echo "Running workflow linters through mise..."
  if ! mise run lint-workflows; then
    FAILED=1
  fi
fi

if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "ERROR: Linters found issues. Fix before committing."
  exit 1
fi
